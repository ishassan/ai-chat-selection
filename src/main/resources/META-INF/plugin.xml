<idea-plugin url="https://github.com/ishassan/ai-chat-selection">
  <id>ai-chat-selection</id>
  <name>ai-chat-selection</name>
  <version>1.0.0</version>
  <vendor url="https://github.com/ishassan">ishassan</vendor>

  <description><![CDATA[
    <p>Syncs selected IntelliJ editor text into JetBrains AI Chat.</p>
    <ul>
      <li>Adds and refreshes the current <code>@selection</code> reference.</li>
      <li>Opens the current AI Chat when needed and focuses its input.</li>
      <li>Ignores selections made inside the AI Chat input.</li>
      <li>On macOS, runs assigned single-key Option shortcuts in IntelliJ text fields without adding shortcut text.</li>
    </ul>
  ]]></description>

  <change-notes><![CDATA[
    <p>First release of ai-chat-selection.</p>
  ]]></change-notes>

  <idea-version since-build="262.10968.1" until-build="262.10968.*" />

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.ml.llm</depends>
  <incompatible-with>local.ai-chat-focus</incompatible-with>

  <actions>
    <action
        id="Local.AIChat.OpenAndFocusInput"
        class="local.aichatfocus.OpenAndFocusAiChatAction"
        text="Focus AI Chat Input"
        description="Open the current AI Chat when needed and focus its text box" />
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="local.aichatfocus.OptionShortcutSettings" os="mac" />
    <applicationService serviceImplementation="local.aichatfocus.OptionShortcutInterceptor" os="mac" />
    <applicationConfigurable
        id="ai-chat-selection.option-shortcuts"
        parentId="tools"
        displayName="ai-chat-selection"
        instance="local.aichatfocus.OptionShortcutConfigurable"
        os="mac" />
    <postStartupActivity implementation="local.aichatfocus.AiChatSelectionSyncStartupActivity" />
  </extensions>
</idea-plugin>
